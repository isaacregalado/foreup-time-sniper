# ─── Bethpage Sniper Configuration ───────────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#

# ── Gmail (for booking code retrieval) ───────────────────
# Your foreUP account email (the one that receives booking codes)
GMAIL_EMAIL=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
# 1. Go to Google Account → Security → 2-Step Verification → App Passwords
# 2. Create a new app password (select "Mail" or "Other")
# 3. Copy the 16-character password here (spaces don't matter)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Booking Preferences ──────────────────────────────────
# Target tee time (24-hour format)
TARGET_HOUR=7
TARGET_MINUTE=30

# How many minutes +/- from target to accept (e.g., 15 = 7:15am-7:45am)
TIME_WINDOW=15

# Number of players (1-4)
PLAYERS=4

# Holes (9 or 18)
HOLES=18

# ── Target Date ──────────────────────────────────────────
# Leave empty for auto (7 days from today)
# Or set a specific date: MM-DD-YYYY (e.g., 04-05-2026)
TARGET_DATE=

# ── Advanced ─────────────────────────────────────────────
# Seconds before 7PM to start refreshing (default: 3)
PRE_DROP_SECONDS=3

# Milliseconds to wait after page load before checking for times
RENDER_DELAY_MS=250

# ── Race mode (turbo.ts --race) ──────────────────────────
# Pipelined polling + one isolated serial actor per course. The fastest bounded
# single-account path. Enable with RACE=1 or the --race flag.
RACE=1
# Accept 6:30am through the last normal grid slot before 8:30am. Configured
# COURSE order is priority; latest-first avoids the obvious first-slot herd.
COURSE=red,green
WINDOW_START=6:30
WINDOW_END=8:30
FALLBACK_UNTIL=8:30
SLOT_ORDER=latest
# Tunables are CLI-only flags:
#   --poll-concurrency 6   max in-flight poll requests (low = fast client, not a flood)
#   --poll-stagger 12      ms between launching polls
#   --candidates 3         ranked slots to walk serially per course after rejection
#                          the rest expire on their own at $0

# Booking-fee card for the Element payment window (no saved-card option there).
# Leave blank to type the card manually at the end. All four required for pre-fill / --auto-book.
FEE_CARD_NUMBER=
FEE_CARD_EXP_MONTH=
FEE_CARD_EXP_YEAR=
FEE_CARD_CVV=
